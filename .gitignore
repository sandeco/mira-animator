node_modules/
.npm-cache/
*.log
.DS_Store
agents/mira-builder/videos_header/
templates/videos_header/
decks/**/assets/*.glb

# Chaves de API locais (ex.: GEMINI_API_KEY). Nunca vao para o repo.
.env
.env.*
!.env.example

# MkDocs build output
.site/

# Notas/rascunhos locais
no_permissions.md

# Desenvolvimento do MIRA (so no repo privado)
.claude/
.agents/
AGENTS.md
CLAUDE.md
dev/
studio-plus/

# Devcontainer (config local, nao vai para o repo publico)
.devcontainer/

# Repo privado sobreposto
.git-private/

# Reversa
.reversa/
_reversa_sdd/
_reversa_docs/
_reversa_forward/

# Decks: publico so os exemplos curados (allowlist)
decks/*
!decks/exemplo-responsivo/
!decks/mira-launch/
!decks/mira-edit-livre-demo/
!decks/site-mira-responsivo/
!decks/you-shall-not-pass/

# Videos de teste pesados nos decks
decks/**/*.mp4

# Decks de teste (nao vao para o repo publico). Os testes de verdade ficam
# em test/ (singular), que e o que o "npm test" roda.
tests/

# Brainstorms e notas de ideacao: material de trabalho, nao documentacao
BRAINSTORMING/
evolução/

# Decks gerados ao exercitar cada skill: saida de teste local (59 MB), o
# repo publica so os decks curados da allowlist acima
examples/

# Config de uma INSTALACAO do Mira, com caminhos da maquina do usuario.
# O repo e a fonte, nao uma instalacao.
mira.config.json

# Registro de geracao do /mira-fast: fica no disco para inspecao, fora do repo
decks/**/mira/fast/

# Saida de instalar o Mira dentro do proprio repo fonte.
# Instalar aqui e o jeito de os agentes virarem /comando durante o
# desenvolvimento, mas o resultado e copia do que ja esta versionado em
# agents/ e templates/, entao commitar seria duplicar o repo dentro dele.
mira-templates/
.mira/
